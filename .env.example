# Copy this file to .env and replace every value. .env is in .gitignore.
# A good random value:  python -c "import secrets; print(secrets.token_urlsafe(24))"

# REST API: one key per role (at least 16 characters)
API_KEY_PREDICT=change-me-predict-key-0000
API_KEY_LABELS=change-me-labels-key-00000
API_KEY_MONITOR=change-me-monitor-key-0000
API_KEY_ADMIN=change-me-admin-key-000000

# PostgreSQL (prediction log, labels, pipeline events). Not reachable from outside Docker.
POSTGRES_USER=fraud
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=fraud

# MLflow tracking server with login (basic auth). The user name is always "admin".
MLFLOW_ADMIN_PASSWORD=change-me-mlflow
MLFLOW_SECRET_KEY=change-me-mlflow-csrf-secret

# Jenkins admin user (created automatically by Jenkins Configuration as Code)
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-jenkins

# Used by python -m simulation.replay on your own computer
API_URL=http://localhost:8000
JENKINS_URL=http://localhost:8080
